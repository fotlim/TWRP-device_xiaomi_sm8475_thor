diff --git a/gui/pages.cpp b/gui/pages.cpp
index b1825757..a1e987b5 100755
--- a/gui/pages.cpp
+++ b/gui/pages.cpp
@@ -56,6 +56,7 @@ extern "C" {
 #include "rapidxml.hpp"
 #include "objects.hpp"
 #include "blanktimer.hpp"
+#include "wallpaper.hpp"
 
 // version 2 requires theme to handle power button as action togglebacklight
 #define TW_THEME_VERSION 3
@@ -556,9 +557,28 @@ bool Page::ProcessNode(xml_node<>* page, std::vector<xml_node<>*> *templates, in
 
 int Page::Render(void)
 {
-	// Render background
-	gr_color(mBackground.red, mBackground.green, mBackground.blue, mBackground.alpha);
-	gr_fill(0, 0, gr_fb_width(), gr_fb_height());
+	// Render background. The wallpaper is painted once by PageManager::Render()
+	// underneath everything, so this plate has to stay partly transparent while a
+	// wallpaper is set - otherwise it would paint over the photo. mBackground is a
+	// snapshot taken when the page was built, so clamp the alpha here rather than
+	// trusting the value captured at construction time.
+	//
+	// The lock cover is handled below: it repaints the wallpaper first so that it
+	// can stay translucent without letting the previous page bleed through.
+	{
+		unsigned char alpha = mBackground.alpha;
+		if (wallpaper_is_active()) {
+			// The lock cover is drawn above the page it hides, so repaint the
+			// wallpaper here as well - the photo becomes the cover's backdrop and
+			// whatever was on screen before cannot show through the glass plate.
+			if (mName == "lock")
+				wallpaper_render();
+			if (alpha > WP_PAGE_BG_ALPHA)
+				alpha = WP_PAGE_BG_ALPHA;
+		}
+		gr_color(mBackground.red, mBackground.green, mBackground.blue, alpha);
+		gr_fill(0, 0, gr_fb_width(), gr_fb_height());
+	}
 
 	// Render remaining objects
 	std::vector<RenderObject*>::iterator iter;
@@ -850,6 +870,11 @@ int PageSet::Load(LoadingContext& ctx, const std::string& filename)
 		}
 	}
 
+	// All colour variables of this file (and of everything it included) are final
+	// now. Restyle the big surfaces if the user has a wallpaper configured, so the
+	// photo shows through while text keeps a readable plate underneath.
+	wallpaper_apply_translucency();
+
 	return 0;
 }
 
@@ -1142,6 +1167,7 @@ int PageSet::LoadVariables(xml_node<>* vars)
 
 		child = child->next_sibling("variable");
 	}
+
 	return 0;
 }
 
@@ -1675,6 +1701,10 @@ int PageManager::Render(void)
 	if (blankTimer.isScreenOff())
 		return 0;
 
+	// User wallpaper: painted once, underneath every page and overlay, so it is
+	// visible globally instead of only in the gaps between themed surfaces.
+	wallpaper_render();
+
 	int res = (mCurrentSet ? mCurrentSet->Render() : -1);
 	if (mMouseCursor)
 		mMouseCursor->Render();
