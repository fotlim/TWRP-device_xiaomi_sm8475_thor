+/*
+	Custom wallpaper background for OrangeFox Recovery
+
+	Provides a user-selectable full-screen background image that is drawn
+	underneath every page.  Four rendering modes are supported:
+
+	  1 - original  : plain scaled/cropped image
+	  2 - dim       : image darkened by a translucent black layer
+	  3 - gradient  : image with a vertical black gradient on top
+	  4 - blur      : image blurred in software (box blur), then darkened a bit
+
+	The image is decoded once and cached; the cache is dropped whenever the
+	configured path or mode changes.
+*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <string>
+#include <algorithm>
+#include <map>
+
+extern "C" {
+#include "../twcommon.h"
+#include "gui.h"
+}
+#include "minuitwrp/minui.h"
+
+#include <pixelflinger/pixelflinger.h>
+
+#include "../data.hpp"
+#include "pages.hpp"
+#include "wallpaper.hpp"
+
+// Rendering modes
+#define WP_MODE_OFF       0
+#define WP_MODE_ORIGINAL  1
+#define WP_MODE_DIM       2
+#define WP_MODE_GRADIENT  3
+#define WP_MODE_BLUR      4
+
+// Tunables
+#define WP_DIM_ALPHA      150   // 0..255, black overlay strength for "dim"
+#define WP_GRAD_TOP_ALPHA 0
+#define WP_GRAD_BOT_ALPHA 215
+#define WP_BLUR_RADIUS    10
+#define WP_BLUR_PASSES    2
+#define WP_MAX_SURFACE_MB 160
+
+static gr_surface gSurface = NULL;
+static std::string gSurfacePath;
+static int gSurfaceMode = -1;
+
+static void free_cached(void)
+{
+	if (gSurface) {
+		res_free_surface(gSurface);
+		gSurface = NULL;
+	}
+	gSurfacePath.clear();
+	gSurfaceMode = -1;
+}
+
+void wallpaper_invalidate(void)
+{
+	free_cached();
+}
+
+// Force every pixel opaque so gr_blit() takes the fast non-blending path and
+// the wallpaper never leaks whatever the framebuffer held before.
+static void force_rgbx(GGLSurface* s)
+{
+	if (!s || !s->data)
+		return;
+	const int w = (int)s->width;
+	const int h = (int)s->height;
+	const int stride = (int)s->stride;   // pixels, not bytes
+	if (w <= 0 || h <= 0)
+		return;
+	for (int y = 0; y < h; ++y) {
+		unsigned char* row = s->data + (size_t)y * stride * 4;
+		for (int x = 0; x < w; ++x)
+			row[x * 4 + 3] = 0xff;
+	}
+	s->format = GGL_PIXEL_FORMAT_RGBX_8888;
+}
+
+// Separable box blur, operates in place on a 4-byte-per-pixel surface.
+static void blur_surface(GGLSurface* s, int radius, int passes)
+{
+	if (!s || !s->data || radius < 1 || passes < 1)
+		return;
+
+	const int w = (int)s->width;
+	const int h = (int)s->height;
+	const size_t stride = (size_t)s->stride * 4;
+	if (w < 2 || h < 2)
+		return;
+
+	unsigned char* tmp = (unsigned char*)malloc(stride * h);
+	if (!tmp) {
+		LOGINFO("wallpaper: no memory for blur buffer, skipping blur\n");
+		return;
+	}
+
+	const int span = radius * 2 + 1;
+
+	for (int pass = 0; pass < passes; ++pass) {
+		// Horizontal
+		for (int y = 0; y < h; ++y) {
+			const unsigned char* src = s->data + (size_t)y * stride;
+			unsigned char* dst = tmp + (size_t)y * stride;
+			for (int c = 0; c < 3; ++c) {
+				int acc = 0;
+				for (int i = -radius; i <= radius; ++i) {
+					int x = std::min(std::max(i, 0), w - 1);
+					acc += src[x * 4 + c];
+				}
+				for (int x = 0; x < w; ++x) {
+					dst[x * 4 + c] = (unsigned char)(acc / span);
+					int xout = std::min(std::max(x - radius, 0), w - 1);
+					int xin  = std::min(std::max(x + radius + 1, 0), w - 1);
+					acc += src[xin * 4 + c] - src[xout * 4 + c];
+				}
+			}
+		}
+
+		// Vertical
+		for (int x = 0; x < w; ++x) {
+			for (int c = 0; c < 3; ++c) {
+				int acc = 0;
+				for (int i = -radius; i <= radius; ++i) {
+					int y = std::min(std::max(i, 0), h - 1);
+					acc += tmp[(size_t)y * stride + x * 4 + c];
+				}
+				for (int y = 0; y < h; ++y) {
+					s->data[(size_t)y * stride + x * 4 + c] = (unsigned char)(acc / span);
+					int yout = std::min(std::max(y - radius, 0), h - 1);
+					int yin  = std::min(std::max(y + radius + 1, 0), h - 1);
+					acc += tmp[(size_t)yin * stride + x * 4 + c]
+					     - tmp[(size_t)yout * stride + x * 4 + c];
+				}
+			}
+		}
+	}
+
+	free(tmp);
+}
+
+// Mix a black veil into the surface rows [y0, y1).  Baking the darkening into
+// the cached surface keeps the per-frame path down to a single blit.
+static void veil_surface(GGLSurface* s, int y0, int y1, int alpha)
+{
+	if (!s || !s->data || alpha <= 0)
+		return;
+	const int w = (int)s->width;
+	const int h = (int)s->height;
+	const int stride = (int)s->stride;
+	if (y0 < 0) y0 = 0;
+	if (y1 > h) y1 = h;
+	if (alpha > 255) alpha = 255;
+	const int keep = 255 - alpha;
+	for (int y = y0; y < y1; ++y) {
+		unsigned char* row = s->data + (size_t)y * stride * 4;
+		for (int x = 0; x < w; ++x) {
+			row[x * 4 + 0] = (unsigned char)((row[x * 4 + 0] * keep) / 255);
+			row[x * 4 + 1] = (unsigned char)((row[x * 4 + 1] * keep) / 255);
+			row[x * 4 + 2] = (unsigned char)((row[x * 4 + 2] * keep) / 255);
+		}
+	}
+}
+
+// Decode + scale + crop the configured image into a screen-sized surface and
+// apply any baked-in effect.  Returns NULL on failure.
+static gr_surface build_surface(const std::string& path, int mode)
+{
+	gr_surface img = NULL;
+
+	if (path.empty()) {
+		LOGINFO("wallpaper: no path configured\n");
+		return NULL;
+	}
+	if (res_create_surface(path.c_str(), &img) != 0 || !img) {
+		LOGERR("wallpaper: cannot decode '%s'\n", path.c_str());
+		return NULL;
+	}
+
+	const int fbw = gr_fb_width();
+	const int fbh = gr_fb_height();
+	if (fbw <= 0 || fbh <= 0) {
+		res_free_surface(img);
+		return NULL;
+	}
+
+	const int iw = (int)gr_get_width(img);
+	const int ih = (int)gr_get_height(img);
+	if (iw <= 0 || ih <= 0) {
+		res_free_surface(img);
+		return NULL;
+	}
+
+	// Scale to cover the whole screen, then centre-crop the overflow.
+	float scale = std::max((float)fbw / iw, (float)fbh / ih);
+	if (scale <= 0.0f)
+		scale = 1.0f;
+
+	const double need_mb =
+		(double)((size_t)(iw * scale) * (size_t)(ih * scale) * 4) / (1024.0 * 1024.0);
+	if (need_mb > WP_MAX_SURFACE_MB) {
+		LOGERR("wallpaper: image too large after scaling (%.0f MB), refusing\n", need_mb);
+		res_free_surface(img);
+		return NULL;
+	}
+
+	gr_surface scaled = NULL;
+	if (res_scale_surface(img, &scaled, scale, scale) != 0 || !scaled) {
+		LOGERR("wallpaper: scaling failed\n");
+		return NULL;
+	}
+	// res_scale_surface() frees the source surface for us.
+	GGLSurface* s = (GGLSurface*)scaled;
+
+	if (mode == WP_MODE_BLUR)
+		blur_surface(s, WP_BLUR_RADIUS, WP_BLUR_PASSES);
+
+	force_rgbx(s);
+
+	// Bake the darkening effect in, so drawing the wallpaper is one blit.
+	if (mode == WP_MODE_DIM) {
+		veil_surface(s, 0, (int)s->height, WP_DIM_ALPHA);
+	} else if (mode == WP_MODE_GRADIENT) {
+		const int strips = 64;
+		const int sh = (int)s->height;
+		const int strip_h = (sh + strips - 1) / strips;
+		for (int i = 0; i < strips; ++i) {
+			int y = i * strip_h;
+			if (y >= sh)
+				break;
+			int h = std::min(strip_h, sh - y);
+			int a = WP_GRAD_TOP_ALPHA +
+			        (WP_GRAD_BOT_ALPHA - WP_GRAD_TOP_ALPHA) * i / (strips - 1);
+			veil_surface(s, y, y + h, a);
+		}
+	} else if (mode == WP_MODE_BLUR) {
+		veil_surface(s, 0, (int)s->height, 90);
+	}
+
+	LOGINFO("wallpaper: built %ux%u surface from '%s' (mode %d)\n",
+	        s->width, s->height, path.c_str(), mode);
+	return scaled;
+}
+
+// ---------------------------------------------------------------------------
+// Wallpaper visibility: translucent theme surfaces
+//
+// TWRP themes paint large opaque rectangles behind the page, the lists and the
+// cards.  A user wallpaper is drawn underneath all of them, so without this the
+// image only peeks out through the gaps between widgets.  While a wallpaper is
+// configured we rewrite those colour variables so the surfaces become tinted
+// glass plates and the photo shows through.
+//
+// Nothing is cached and nothing is "restored" here: a theme reload always
+// re-reads the original values from the XML, so switching the wallpaper off and
+// reloading is enough to get the opaque look back.  That also means this can run
+// as many times as the loader likes without ever double-dimming a colour.
+// ---------------------------------------------------------------------------
+
+static bool wallpaper_is_configured(void)
+{
+	std::string path;
+	DataManager::GetValue("wallpaper_path", path);
+	int mode = DataManager::GetIntValue("wallpaper_mode");
+	if (mode < WP_MODE_ORIGINAL || mode > WP_MODE_BLUR)
+		return false;
+	if (path.empty() || path == "none")
+		return false;
+	return true;
+}
+
+void wallpaper_apply_translucency(void)
+{
+	if (!wallpaper_is_configured())
+		return;
+
+	// name -> alpha of the plate that stays behind the text
+	static const struct { const char *name; unsigned char alpha; } plates[] = {
+		{ "background", 0x66 },   // page background, dialogs
+		{ "power_bg",   0x66 },   // power menu plates
+		{ "cards_bg",   0xB4 },   // cards, lists, nav panel, search bar
+	};
+
+	for (size_t i = 0; i < sizeof(plates) / sizeof(plates[0]); ++i) {
+		std::string val;
+		if (DataManager::GetValue(plates[i].name, val) != 0)
+			continue;
+		// Only plain #RRGGBB colours are rewritten.  Anything else is either not a
+		// colour or already translated - leave it untouched so repeated calls are
+		// harmless.
+		if (val.size() != 7 || val[0] != '#')
+			continue;
+
+		char buf[16];
+		snprintf(buf, sizeof(buf), "%s%02X", val.c_str(), plates[i].alpha);
+		DataManager::SetValue(plates[i].name, buf, 0);
+	}
+
+	LOGINFO("wallpaper: surfaces made translucent for the background image\n");
+}
+
+int wallpaper_is_active(void)
+{
+    return (gSurface != NULL) ? 1 : 0;
+}
+
+int wallpaper_render(void)
+{
+	std::string path;
+	DataManager::GetValue("wallpaper_path", path);
+
+	int mode = DataManager::GetIntValue("wallpaper_mode");
+	if (mode < WP_MODE_OFF || mode > WP_MODE_BLUR)
+		mode = WP_MODE_OFF;
+
+	if (path.empty() || mode == WP_MODE_OFF) {
+		if (gSurface) {
+			LOGINFO("wallpaper: disabled, dropping cached surface\n");
+			free_cached();
+		}
+		return 0;
+	}
+
+	// The theme colours follow the wallpaper, so ask for one reload whenever the
+	// selection changes.  Guarded by a static so it happens once per change and
+	// cannot bounce back and forth with the reload it triggers.
+	{
+		static std::string lastPath;
+		static int lastMode = -1;
+		static bool pending = false;
+		if (path != lastPath || mode != lastMode) {
+			lastPath = path;
+			lastMode = mode;
+			pending = true;
+		}
+		if (pending) {
+			pending = false;
+			wallpaper_apply_translucency();
+			PageManager::RequestReload();
+		}
+	}
+
+	// (Re)build whenever the selection changed.
+	if (!gSurface || path != gSurfacePath || mode != gSurfaceMode) {
+		free_cached();
+		gSurface = build_surface(path, mode);
+		if (!gSurface)
+			return 0;
+		gSurfacePath = path;
+		gSurfaceMode = mode;
+	}
+
+	const int fbw = gr_fb_width();
+	const int fbh = gr_fb_height();
+	const int sw = (int)gr_get_width(gSurface);
+	const int sh = (int)gr_get_height(gSurface);
+
+	// Centre-crop: pick a source rectangle exactly one screen big.
+	int sx = (sw - fbw) / 2;
+	int sy = (sh - fbh) / 2;
+	if (sx < 0) sx = 0;
+	if (sy < 0) sy = 0;
+	int cw = std::min(fbw, sw);
+	int ch = std::min(fbh, sh);
+
+	// Opacity and every effect are baked into the surface, so this is the whole
+	// per-frame cost of the wallpaper.
+	gr_blit(gSurface, sx, sy, cw, ch, 0, 0);
+
+	return 0;
+}
