+	// Render background. The wallpaper is painted once by PageManager::Render()
+	// underneath everything, so this plate has to stay partly transparent while a
+	// wallpaper is set - otherwise it would paint over the photo. mBackground is a
+	// snapshot taken when the page was built, so clamp the alpha here rather than
+	// trusting the value captured at construction time.
+	//
+	// The lock cover is handled below: it repaints the wallpaper first so that it
+	// can stay translucent without letting the previous page bleed through.
+	{
+		unsigned char alpha = mBackground.alpha;
+		if (wallpaper_is_active()) {
+			// The lock cover is drawn above the page it hides, so repaint the
+			// wallpaper here as well - the photo becomes the cover's backdrop and
+			// whatever was on screen before cannot show through the glass plate.
+			if (mName == "lock")
+				wallpaper_render();
+			if (alpha > WP_PAGE_BG_ALPHA)
+				alpha = WP_PAGE_BG_ALPHA;
+		}
+		gr_color(mBackground.red, mBackground.green, mBackground.blue, alpha);
+		gr_fill(0, 0, gr_fb_width(), gr_fb_height());
+	}
 
 	// Render remaining objects
 	std::vector<RenderObject*>::iterator iter;
