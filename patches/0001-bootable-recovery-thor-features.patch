+/*
+	Custom wallpaper background for OrangeFox Recovery
+	Adds a user-selectable full-screen background image with
+	original / dimmed / gradient / blurred rendering modes.
+*/
+
+#ifndef _CUSTOM_WALLPAPER_HPP_
+#define _CUSTOM_WALLPAPER_HPP_
+
+// Draw the custom wallpaper over the whole framebuffer.
+// Does nothing when no wallpaper is configured.
+// Called from Page::Render() right after the page background fill.
+int wallpaper_render(void);
+int wallpaper_is_active(void);
+
+// While a wallpaper is set, make the theme's big surface colours translucent
+// so the image is visible behind lists and cards instead of only in the gaps.
+// Re-run after every theme load; it never has to be undone explicitly, because
+// a reload re-reads the original colours from the theme XML.
+void wallpaper_apply_translucency(void);
+
+// Cap for a page background plate so a wallpaper stays visible behind it.
+#define WP_PAGE_BG_ALPHA  0x66
+
+// Drop the cached surface so the next render rebuilds it.
+// Called when the user changes the image or the mode.
+void wallpaper_invalidate(void);
+
+#endif // _CUSTOM_WALLPAPER_HPP_
